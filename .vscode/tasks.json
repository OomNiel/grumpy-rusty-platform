{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "compile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            // `tsc -p ./` output, so errors land in the Problems pane rather than only in
            // the terminal (and the same task runs before every F5).
            "problemMatcher": [
                "$tsc"
            ],
            "presentation": {
                "reveal": "silent",
                "clear": true
            }
        }
    ]
}