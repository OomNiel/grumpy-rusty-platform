{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "compile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            // `tsc -p ./` output, so errors land in the Problems pane rather than only in
            // the terminal (and the same task runs before every F5).
            "problemMatcher": [
                "$tsc"
            ],
            "presentation": {
                "reveal": "silent",
                "clear": true
            }
        },
        {
            // The extension development host opens this folder (see launch.json), so the
            // Rusty Platform commands have a project to act on straight away.
            "label": "make demo project",
            "type": "shell",
            "command": "node",
            "args": [
                "tests/tools/make-demo-project.js"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "prepare demo project",
            "dependsOn": [
                "compile",
                "make demo project"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}