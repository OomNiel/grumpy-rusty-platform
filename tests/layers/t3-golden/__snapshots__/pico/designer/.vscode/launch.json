{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "probe-rs-debug",
      "request": "launch",
      "name": "Flash & Debug (RP2040)",
      "cwd": "${workspaceFolder}",
      "chip": "RP2040",
      "flashingConfig": {
        "flashingEnabled": true
      },
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "target/thumbv6m-none-eabi/debug/snapshot-project",
          "rttEnabled": true
        }
      ]
    },
    {
      "type": "probe-rs-debug",
      "request": "launch",
      "name": "Flash & Halt at Reset (RP2040)",
      "cwd": "${workspaceFolder}",
      "chip": "RP2040",
      "flashingConfig": {
        "flashingEnabled": true,
        "haltAfterReset": true
      },
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "target/thumbv6m-none-eabi/debug/snapshot-project",
          "rttEnabled": true
        }
      ]
    },
    {
      "type": "probe-rs-debug",
      "request": "launch",
      "name": "Restart & Debug, no flashing (RP2040)",
      "cwd": "${workspaceFolder}",
      "chip": "RP2040",
      "flashingConfig": {
        "flashingEnabled": false
      },
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "target/thumbv6m-none-eabi/debug/snapshot-project",
          "rttEnabled": true
        }
      ]
    },
    {
      "type": "probe-rs-debug",
      "request": "attach",
      "name": "Attach - keeps it running (RP2040)",
      "cwd": "${workspaceFolder}",
      "chip": "RP2040",
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "target/thumbv6m-none-eabi/debug/snapshot-project",
          "rttEnabled": true
        }
      ]
    }
  ]
}
