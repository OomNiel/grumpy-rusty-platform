/* Generated by Grumpy's Rusty Platform for VS Code. */
MEMORY {
    FLASH : ORIGIN = 0x10000000, LENGTH = 3072K
    RAM   : ORIGIN = 0x20000000, LENGTH = 512K
    SRAM8 : ORIGIN = 0x20080000, LENGTH = 4K
    SRAM9 : ORIGIN = 0x20081000, LENGTH = 4K
    /* Reserved "drive space" — not linked into by the application. */
    FS : ORIGIN = 0x10300000, LENGTH = 1024K
}

SECTIONS {
    /* Boot ROM image definition, kept inside the first 4K of flash
       so the ROM (and picotool) can find it. */
    .start_block : ALIGN(4) {
        __start_block_addr = .;
        KEEP(*(.start_block));
        KEEP(*(.boot_info));
    } > FLASH
} INSERT AFTER .vector_table;

_stext = ADDR(.start_block) + SIZEOF(.start_block);

SECTIONS {
    /* Picotool `binary info` entries. */
    .bi_entries : ALIGN(4) {
        __bi_entries_start = .;
        KEEP(*(.bi_entries));
        . = ALIGN(4);
        __bi_entries_end = .;
    } > FLASH
} INSERT AFTER .text;
