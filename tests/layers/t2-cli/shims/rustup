#!/bin/sh
# Fake `rustup` for the t2-cli layer.
#   SHIM_TARGETS  newline-separated list reported by `rustup target list --installed`
#                 (an explicitly empty value means "no targets installed")
case "$1" in
  --version)
    echo "rustup 1.29.1 (d95a37b6a 2026-08-13)"
    exit 0
    ;;
  target)
    if [ "$2" = "list" ] && [ "$3" = "--installed" ]; then
      printf '%s\n' "${SHIM_TARGETS-thumbv6m-none-eabi}"
      exit 0
    fi
    ;;
  toolchain)
    # `rustup toolchain list` is how the ESP check finds out whether espup has installed its
    # toolchain. SHIM_TOOLCHAINS holds the lines it prints; empty means "none installed".
    if [ "$2" = "list" ]; then
      printf '%s\n' "${SHIM_TOOLCHAINS-stable-x86_64-unknown-linux-gnu (default)}"
      exit 0
    fi
    ;;
esac
echo "fake-rustup: unexpected arguments: $*" >&2
exit 2
