#!/usr/bin/env bash
# A fake `pool` for the t2 layer: the CLI contract, without Poolside and without a network.
#
# It is deliberately literal about the three things the extension depends on, all measured against the real
# 1.0.16 binary on 2026-10-12:
#   * the prompt arrives on STDIN (`exec -p -`). The number of bytes it actually read is reported back, so a
#     test can prove the scripted prompt went in that way rather than through an argument — which would put a
#     developer's own code in the process list;
#   * stdout is NDJSON, one JSON object per line, exactly as `pool exec -o json` writes it;
#   * the exit codes are pool's own: 0 done, 4 the agent saying it could not finish, anything else an error.
#
# SHIM_POOL_MODE: ok (default) | failed | error | slow | junk
set -u

mode="${SHIM_POOL_MODE:-ok}"

# `pool --version` and `pool config` are asked through their own paths, so they must answer without a prompt.
if [ "${1:-}" = "--version" ]; then
    echo "pool 1.0.16 (fake)"
    exit 0
fi
if [ "${1:-}" = "config" ]; then
    echo "log directory: /tmp/pool-logs"
    echo "trajectory directory: ${SHIM_POOL_TRAJECTORIES:-/tmp/pool-trajectories}"
    exit 0
fi

args="$*"
prompt="$(cat)"
bytes=${#prompt}
first_line="$(printf '%s' "$prompt" | head -1)"

case "$mode" in
    slow)
        printf '{"message":"starting a long job","type":"assistantMessage"}\n'
        sleep 30
        exit 0
        ;;
    error)
        echo "Error: rate limit exceeded" >&2
        exit 2
        ;;
    junk)
        printf 'not json at all\n'
        printf '{"message":"still here","type":"assistantMessage"}\n'
        printf '{"type":"aShapeFromTheFuture","value":1}\n'
        printf '{"message":"carried on regardless","type":"assistantMessage"}\n'
        exit 0
        ;;
    failed)
        printf '{"message":"I could not find the pin table.","type":"assistantMessage"}\n'
        printf '{"args":{"success":false},"name":"exit","type":"toolCall"}\n'
        exit 4
        ;;
    *)
        printf '{"args":{"path":"src/main.rs"},"name":"edit_file","type":"toolCall"}\n'
        printf '{"args":{"command":"cargo check"},"name":"run_command","type":"toolCall"}\n'
        printf '{"message":"read %s bytes | args: %s | first: %s","type":"assistantMessage"}\n' "$bytes" "$args" "$first_line"
        printf '{"args":{"success":true},"name":"exit","type":"toolCall"}\n'
        printf '{"result":"","type":"toolCallResult"}\n'
        exit 0
        ;;
esac
