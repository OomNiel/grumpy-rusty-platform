#!/usr/bin/env bash
# A fake `jcode` for the t2 layer: the measured contract, without Agnes and without a network.
#
# Deliberately literal about the things the extension depends on, all measured against the real v0.75.0 binary on
# 2026-10-13 (`tests/layers/t2-cli/fixtures/jcode-run.ndjson` is that measurement, kept from a real run):
#   * the message arrives as the **last argument** (`jcode run [OPTIONS] <MESSAGE>`), which is the opposite of
#     pool's `-p -`. This shim reports both what it was given in argv and what it found on stdin, so a test can
#     prove the driver used argv — that is the whole difference between the two drivers;
#   * stdout is NDJSON events: `start` (with the session id), `connection_phase`, `text_delta`, `tool_start`,
#     `tool_input` (which carries **no id**, so it belongs to the most recent `tool_start`), `tool_exec`,
#     `tool_done`, `tokens`, `message_end` and a closing `done` carrying the whole answer and the usage;
#   * exit 0 means the run finished. No second code is invented here, because none was measured.
#
# SHIM_JCODE_MODE: ok (default) | slow | error | junk | failed-tools | unfinished
set -u

mode="${SHIM_JCODE_MODE:-ok}"

# `jcode --version` is asked through its own path, so it must answer without a message.
if [ "${1:-}" = "--version" ]; then
    echo "jcode v0.75.0 (fake)"
    exit 0
fi

if [ "$#" -eq 0 ]; then
    echo "error: no message" >&2
    exit 2
fi

message="${!#}"
stdin_bytes=$(cat | wc -c | tr -d ' ')
session="${SHIM_JCODE_SESSION:-session_probe_1791901733357_8cd680a40913a606}"

# Whether the driver passed --resume, and with what value: the flag and its argument are decided by `jcodeArgs`,
# and this proves they survived the argument list end to end rather than only in a pure assertion.
resume="none"
previous=""
for argument in "$@"; do
    if [ "$previous" = "--resume" ]; then resume="$argument"; fi
    previous="$argument"
done

emit_start() {
    printf '{"model":"agnes-2.5-flash","provider":"openrouter","session_id":"%s","type":"start"}\n' "$session"
    printf '{"connection":"https/sse","type":"connection_type"}\n'
    printf '{"phase":"sending request","type":"connection_phase"}\n'
    printf '{"phase":"waiting for response","type":"connection_phase"}\n'
}

case "$mode" in
    slow)
        emit_start
        printf '{"text":"thinking","type":"text_delta"}\n'
        sleep 30
        exit 0
        ;;
    error)
        echo "jcode: could not reach the provider (401 Unauthorized)" >&2
        exit 2
        ;;
    junk)
        emit_start
        printf 'this is not json\n'
        printf '{"type":"aShapeFromTheFuture","value":1}\n'
        printf '{"text":"carried on regardless","type":"text_delta"}\n'
        printf '{"session_id":"%s","text":" carried on regardless","type":"done"}\n' "$session"
        exit 0
        ;;
    failed-tools)
        emit_start
        printf '{"id":"call_1","name":"write","type":"tool_start"}\n'
        printf '{"delta":"{\\"file_path\\": \\"src/main.rs\\"}","type":"tool_input"}\n'
        printf '{"id":"call_1","name":"write","type":"tool_exec"}\n'
        printf '{"error":"permission denied","id":"call_1","name":"write","output":null,"type":"tool_done"}\n'
        printf '{"stop_reason":"stop","type":"message_end"}\n'
        printf '{"session_id":"%s","status_detail":"the write tool failed","text":"I could not write the file.","type":"done"}\n' "$session"
        exit 0
        ;;
    unfinished)
        # Exit 0 with a last message that was a tool call: "it finished" without "it finished the job".
        emit_start
        printf '{"id":"call_1","name":"bash","type":"tool_start"}\n'
        printf '{"delta":"{\\"command\\": \\"cargo build\\"}","type":"tool_input"}\n'
        printf '{"error":null,"id":"call_1","name":"bash","output":"error[E0425]: cannot find value `x`","type":"tool_done"}\n'
        printf '{"stop_reason":"tool_calls","type":"message_end"}\n'
        printf '{"session_id":"%s","text":"Build still fails.","type":"done"}\n' "$session"
        exit 0
        ;;
    *)
        emit_start
        printf '{"id":"call_1","name":"write","type":"tool_start"}\n'
        # Two deltas for one call, and neither carries the id: the parser has to reassemble them in order onto
        # the call that was opened above.
        printf '{"delta":"{\\"content\\": \\"hello\\", \\"file_path\\": \\"src/main.rs\\", \\"intent\\": \\"","type":"tool_input"}\n'
        printf '{"delta":" write the greeting\\"}","type":"tool_input"}\n'
        printf '{"id":"call_1","name":"write","type":"tool_exec"}\n'
        printf '{"stop_reason":"tool_calls","type":"message_end"}\n'
        printf '{"cache_creation_input":null,"cache_read_input":null,"input":12898,"output":88,"type":"tokens"}\n'
        printf '{"error":null,"id":"call_1","name":"write","output":"Created src/main.rs (1 lines):\\n1+ hello","type":"tool_done"}\n'
        printf '{"text":"done","type":"text_delta"}\n'
        printf '{"stop_reason":"stop","type":"message_end"}\n'
        printf '{"cache_creation_input":null,"cache_read_input":12800,"input":13055,"output":16,"type":"tokens"}\n'
        # ONE printf for the closing event. A format string split across several calls consumes its own
        # placeholders with no arguments — which is how an earlier version of this shim reported empty byte
        # counts, and a test that then "failed for the driver" when the driver was right.
        printf '{"model":"agnes-2.5-flash","provider":"openrouter","session_id":"%s","status_detail":null,"text":"done - message %s bytes, stdin %s bytes, args %s, resume %s","upstream_provider":null,"usage":{"cache_creation_input_tokens":null,"cache_read_input_tokens":12800,"input_tokens":13055,"output_tokens":16},"type":"done"}\n' \
            "$session" "${#message}" "$stdin_bytes" "$#" "$resume"
        exit 0
        ;;
esac
