screen id="SimPanel" width=480 height=320 theme="dark" {
    grid cols="17px 43px 40px 40px 77px 23px 237px 3px" rows="3px 3px 21px 13px 8px 12px 17px 13px 190px 20px 20px" gap=0 padding=0 {
        rect id="band" radius=0 stroke_width=0 fill="#ff0000" stroke="#ffffff" col=0 row=0 col_span=8 row_span=4
        label id="title" text="Odd coordinates" col=1 row=1 col_span=4 row_span=2
        button id="go" text="Button" bg="#3a6ea5" fg="#f0f0f0" text_color="#ffffff" pressed_bg="#2a5a8a" pressed_fg="#ffffff" disabled_bg="#303030" disabled_fg="#808080" focused_bg="#4a7eb5" focused_fg="#ffffff" border_color="#101010" corner_radius=4 col=1 row=5 col_span=1 row_span=2
        circle id="knob" radius=32 stroke_width=0 fill="#3a6ea5" stroke="#ffffff" col=3 row=6 col_span=1 row_span=2
        progress id="meter" value=50 col=0 row=9 col_span=8 row_span=1
        rect id="foot" radius=0 stroke_width=0 fill="#102030" stroke="#ffffff" col=0 row=10 col_span=6 row_span=1
        rect id="foot2" radius=0 stroke_width=0 fill="#203040" stroke="#ffffff" col=6 row=10 col_span=2 row_span=1
        spacer id="tiny" col=7 row=1 col_span=1 row_span=1
    }
}
