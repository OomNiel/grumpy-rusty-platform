screen id="SimPanel" width=480 height=320 theme="dark" {
    font id="test" src="assets/test.bdf" chars="AB"
    grid cols="17px 43px 40px 40px 10px 50px 17px 23px 50px 10px 40px 20px 20px 10px 87px 3px 1fr" rows="3px 3px 21px 13px 8px 12px 17px 13px 30px 30px 5px 5px 21px 4px 5px 10px 10px 1px 4px 15px 3px 1px 26px 18px 2px 20px 5px 4px 11px 1fr" gap=0 padding=0 {
        rect id="band" radius=0 stroke_width=0 fill="#ff0000" stroke="#ffffff" col=0 row=0 col_span=16 row_span=4
        label id="title" text="Odd coordinates" col=1 row=1 col_span=6 row_span=2
        button id="go" text="Button" bg="#3a6ea5" fg="#f0f0f0" text_color="#ffffff" pressed_bg="#2a5a8a" pressed_fg="#ffffff" disabled_bg="#303030" disabled_fg="#808080" focused_bg="#4a7eb5" focused_fg="#ffffff" border_color="#101010" corner_radius=4 col=1 row=5 col_span=1 row_span=2
        circle id="knob" stroke_width=1 fill="#3a6ea5" stroke="#ffffff" col=3 row=6 col_span=1 row_span=2
        progress id="meter" value=50 style="{ let mut style = Style::label(); style.background = Some(Rgb565::new(0, 12, 0)); style.gradient = None; style.foreground = Rgb565::new(31, 0, 31); style }" col=0 row=25 col_span=16 row_span=1
        rect id="foot" radius=0 stroke_width=0 fill="#102030" stroke="#ffffff" col=0 row=26 col_span=8 row_span=3
        rect id="foot2" radius=0 stroke_width=0 fill="#203040" stroke="#ffffff" col=8 row=26 col_span=8 row_span=3
        spacer id="tiny" col=15 row=1 col_span=1 row_span=1
        toggle id="eco" label="Toggle" checked=true off_color="#392852" style="{ let mut style = Style::label(); style.background = Some(Rgb565::new(0, 12, 0)); style.gradient = None; style.accent = Rgb565::new(0, 63, 0); style }" col=2 row=9 col_span=1 row_span=1
        button id="ok" text="Button" bg="#3a6ea5" fg="#f0f0f0" text_color="#ffffff" pressed_bg="#2a5a8a" pressed_fg="#ffffff" disabled_bg="#303030" disabled_fg="#808080" focused_bg="#4a7eb5" focused_fg="#ffffff" border_color="#101010" corner_radius=4 col=10 row=9 col_span=2 row_span=1
        label id="fonted" text="AB" font="test" col=6 row=9 col_span=3 row_span=1
        label id="builtin" text="AB" style="{ let mut style = Style::label(); style.font = FontId::Scaled6x10; style }" col=6 row=12 col_span=3 row_span=3
        button id="builtinButton" text="AB" bg="#3a6ea5" fg="#f0f0f0" text_color="#ffffff" pressed_bg="#2a5a8a" pressed_fg="#ffffff" disabled_bg="#303030" disabled_fg="#808080" focused_bg="#4a7eb5" focused_fg="#ffffff" border_color="#101010" corner_radius=4 style="WidgetStyle::button().with_normal({ let mut style = Style::button(); style.font = FontId::Vector(2); style })" col=10 row=12 col_span=4 row_span=3
        label id="styled" text="AB" style="Style::panel()" col=6 row=16 col_span=3 row_span=4
        table id="grid" col=0 row=22 col_span=6 row_span=2 {
            headers "Name" "Value"
            row "A" "1"
            row "B" "2"
        }
        label id="tinted" text="AB" style="{ let mut style = Style::label(); style.text = Rgb565::new(31, 0, 0); style }" col=10 row=16 col_span=4 row_span=4
        checkbox id="check" label="Check" checked=true box_size=18 box_color="#ff8000" style="{ let mut style = Style::label(); style.background = Some(Rgb565::new(16, 0, 31)); style.gradient = None; style.border.color = Rgb565::new(31, 63, 0); style.border.width = 2; style.text = Rgb565::new(0, 63, 31); style.accent = Rgb565::new(0, 63, 0); style }" col=0 row=11 col_span=5 row_span=2
        spinbox id="spin" min=0 max=100 value=42 digits=4 decimals=0 accent_color="#ff00ff" chevron_color="#00ff00" style="{ let mut style = Style::panel(); style.background = Some(Rgb565::new(0, 12, 12)); style.gradient = None; style.text = Rgb565::new(31, 63, 0); style }" col=0 row=14 col_span=5 row_span=4
        roller id="roll" selected=1 style="{ let mut style = Style::panel(); style.background = Some(Rgb565::new(0, 17, 0)); style.gradient = None; style.text = Rgb565::new(31, 63, 31); style.accent = Rgb565::new(31, 34, 0); style }" col=0 row=19 col_span=5 row_span=2 {
            option "One"
            option "Two"
            option "Three"
        }
        scale id="gauge" mode="radial" min=0 max=10 value=7 major_ticks=3 minor_ticks=2 start_angle=180 end_angle=0 show_labels=true show_needle=true tick_color="#00ffff" needle_color="#ff00ff" style="{ let mut style = Style::panel(); style.background = Some(Rgb565::new(4, 0, 8)); style.gradient = None; style.text = Rgb565::new(31, 63, 0); style }" col=14 row=9 col_span=2 row_span=8
        triangle id="trib" stroke_width=2 fill="#ff0000" stroke="#00ff00" p1x=1000 p1y=0 p2x=0 p2y=1000 p3x=1000 p3y=1000 col=10 row=23 col_span=1 row_span=3
        line id="rule" stroke_width=2 color="#0000ff" col=10 row=27 col_span=3 row_span=1
    }
}
