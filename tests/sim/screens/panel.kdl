screen id="SimPanel" width=480 height=320 theme="dark" {
    font id="test" src="assets/test.bdf" chars="AB"
    grid cols="17px 43px 40px 40px 60px 17px 23px 50px 10px 40px 20px 20px 10px 87px 3px 1fr" rows="3px 3px 21px 13px 8px 12px 17px 13px 30px 30px 10px 30px 10px 30px 4px 26px 18px 2px 20px 5px 4px 11px 1fr" gap=0 padding=0 {
        rect id="band" radius=0 stroke_width=0 fill="#ff0000" stroke="#ffffff" col=0 row=0 col_span=15 row_span=4
        label id="title" text="Odd coordinates" col=1 row=1 col_span=5 row_span=2
        button id="go" text="Button" bg="#3a6ea5" fg="#f0f0f0" text_color="#ffffff" pressed_bg="#2a5a8a" pressed_fg="#ffffff" disabled_bg="#303030" disabled_fg="#808080" focused_bg="#4a7eb5" focused_fg="#ffffff" border_color="#101010" corner_radius=4 col=1 row=5 col_span=1 row_span=2
        circle id="knob" stroke_width=1 fill="#3a6ea5" stroke="#ffffff" col=3 row=6 col_span=1 row_span=2
        progress id="meter" value=50 col=0 row=18 col_span=15 row_span=1
        rect id="foot" radius=0 stroke_width=0 fill="#102030" stroke="#ffffff" col=0 row=19 col_span=7 row_span=3
        rect id="foot2" radius=0 stroke_width=0 fill="#203040" stroke="#ffffff" col=7 row=19 col_span=8 row_span=3
        spacer id="tiny" col=14 row=1 col_span=1 row_span=1
        toggle id="eco" label="Toggle" checked=false col=2 row=9 col_span=1 row_span=1
        button id="ok" text="Button" bg="#3a6ea5" fg="#f0f0f0" text_color="#ffffff" pressed_bg="#2a5a8a" pressed_fg="#ffffff" disabled_bg="#303030" disabled_fg="#808080" focused_bg="#4a7eb5" focused_fg="#ffffff" border_color="#101010" corner_radius=4 col=9 row=9 col_span=2 row_span=1
        label id="fonted" text="AB" font="test" col=5 row=9 col_span=3 row_span=1
        label id="builtin" text="AB" style="{ let mut style = Style::label(); style.font = FontId::Scaled6x10; style }" col=5 row=11 col_span=3 row_span=1
        button id="builtinButton" text="AB" bg="#3a6ea5" fg="#f0f0f0" text_color="#ffffff" pressed_bg="#2a5a8a" pressed_fg="#ffffff" disabled_bg="#303030" disabled_fg="#808080" focused_bg="#4a7eb5" focused_fg="#ffffff" border_color="#101010" corner_radius=4 style="WidgetStyle::button().with_normal({ let mut style = Style::button(); style.font = FontId::Vector(2); style })" col=9 row=11 col_span=4 row_span=1
        label id="styled" text="AB" style="Style::panel()" col=5 row=13 col_span=3 row_span=1
        table id="grid" col=0 row=15 col_span=5 row_span=2 {
            headers "Name" "Value"
            row "A" "1"
            row "B" "2"
        }
        label id="tinted" text="AB" style="{ let mut style = Style::label(); style.text = Rgb565::new(31, 0, 0); style }" col=9 row=13 col_span=4 row_span=1
        triangle id="trib" stroke_width=2 fill="#ff0000" stroke="#00ff00" p1x=1000 p1y=0 p2x=0 p2y=1000 p3x=1000 p3y=1000 col=9 row=16 col_span=1 row_span=3
        line id="rule" stroke_width=2 color="#0000ff" col=9 row=20 col_span=3 row_span=1
    }
}
