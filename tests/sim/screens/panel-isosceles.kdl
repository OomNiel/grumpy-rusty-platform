screen id="SimPanel" width=480 height=320 theme="dark" {
    font id="test" src="assets/test.bdf" chars="AB"
    grid cols="17px 43px 40px 40px 10px 10px 14px 16px 10px 17px 23px 6px 2px 42px 4px 6px 40px 20px 20px 10px 45px 5px 37px 3px 1fr" rows="3px 3px 21px 13px 8px 12px 17px 13px 5px 20px 5px 18px 2px 10px 5px 5px 18px 2px 1px 4px 5px 10px 4px 2px 4px 1px 1px 3px 3px 2px 10px 2px 1px 1px 2px 2px 2px 12px 8px 2px 4px 6px 6px 1px 1px 20px 5px 4px 11px 1fr" gap=0 padding=0 {
        rect id="band" radius=0 stroke_width=0 fill="#ff0000" stroke="#ffffff" col=0 row=0 col_span=24 row_span=4
        label id="title" text="Odd coordinates" col=1 row=1 col_span=9 row_span=2
        button id="go" text="Button" bg="#3a6ea5" fg="#f0f0f0" text_color="#ffffff" pressed_bg="#2a5a8a" pressed_fg="#ffffff" disabled_bg="#303030" disabled_fg="#808080" focused_bg="#4a7eb5" focused_fg="#ffffff" border_color="#101010" corner_radius=4 col=1 row=5 col_span=1 row_span=2
        circle id="knob" stroke_width=1 fill="#3a6ea5" stroke="#ffffff" col=3 row=6 col_span=1 row_span=2
        progress id="meter" value=50 style="{ let mut style = Style::label(); style.background = Some(Rgb565::new(0, 12, 0)); style.gradient = None; style.foreground = Rgb565::new(31, 0, 31); style }" col=0 row=45 col_span=24 row_span=1
        rect id="foot" radius=0 stroke_width=0 fill="#102030" stroke="#ffffff" col=0 row=46 col_span=11 row_span=3
        rect id="foot2" radius=0 stroke_width=0 fill="#203040" stroke="#ffffff" col=11 row=46 col_span=13 row_span=3
        spacer id="tiny" col=23 row=1 col_span=1 row_span=1
        toggle id="eco" label="Toggle" checked=true off_color="#392852" track_border_width=1 style="{ let mut style = Style::label(); style.background = Some(Rgb565::new(0, 12, 0)); style.gradient = None; style.accent = Rgb565::new(0, 63, 0); style }" col=2 row=11 col_span=1 row_span=3
        button id="ok" text="Button" bg="#3a6ea5" fg="#f0f0f0" text_color="#ffffff" pressed_bg="#2a5a8a" pressed_fg="#ffffff" disabled_bg="#303030" disabled_fg="#808080" focused_bg="#4a7eb5" focused_fg="#ffffff" border_color="#101010" corner_radius=4 col=16 row=11 col_span=2 row_span=3
        label id="fonted" text="AB" font="test" col=9 row=11 col_span=5 row_span=3
        label id="builtin" text="AB" style="{ let mut style = Style::label(); style.font = FontId::Scaled6x10; style }" col=9 row=16 col_span=5 row_span=5
        button id="builtinButton" text="AB" bg="#3a6ea5" fg="#f0f0f0" text_color="#ffffff" pressed_bg="#2a5a8a" pressed_fg="#ffffff" disabled_bg="#303030" disabled_fg="#808080" focused_bg="#4a7eb5" focused_fg="#ffffff" border_color="#101010" corner_radius=4 style="WidgetStyle::button().with_normal({ let mut style = Style::button(); style.font = FontId::Vector(2); style })" col=16 row=16 col_span=4 row_span=5
        label id="styled" text="AB" style="Style::panel()" col=9 row=22 col_span=5 row_span=9
        table id="grid" col=0 row=34 col_span=9 row_span=9 {
            headers "Name" "Value"
            row "A" "1"
            row "B" "2"
        }
        label id="tinted" text="AB" style="{ let mut style = Style::label(); style.text = Rgb565::new(31, 0, 0); style }" col=16 row=22 col_span=4 row_span=9
        checkbox id="check" label="Check" checked=true box_width=24 box_height=18 label_position="right" box_color="#ff8000" style="{ let mut style = Style::label(); style.background = Some(Rgb565::new(16, 0, 31)); style.gradient = None; style.border.color = Rgb565::new(31, 63, 0); style.border.width = 2; style.text = Rgb565::new(0, 63, 31); style.accent = Rgb565::new(0, 63, 0); style }" col=0 row=15 col_span=5 row_span=4
        spinbox id="spin" min=0 max=100 value=42 digits=4 decimals=0 accent_color="#ff00ff" chevron_color="#00ff00" style="{ let mut style = Style::panel(); style.background = Some(Rgb565::new(0, 12, 12)); style.gradient = None; style.text = Rgb565::new(31, 63, 0); style }" col=0 row=20 col_span=5 row_span=6
        roller id="roll" selected=1 selection="flick" style="{ let mut style = Style::panel(); style.background = Some(Rgb565::new(0, 17, 0)); style.gradient = None; style.text = Rgb565::new(31, 63, 31); style.accent = Rgb565::new(31, 34, 0); style }" col=0 row=28 col_span=5 row_span=5 {
            option "One"
            option "Two"
            option "Three"
        }
        roller id="rollTouch" selected=0 selection="touch" style="{ let mut style = Style::panel(); style.background = Some(Rgb565::new(0, 8, 0)); style.gradient = None; style.accent = Rgb565::new(0, 63, 0); style }" col=3 row=9 col_span=3 row_span=1 {
            option "One"
            option "Two"
            option "Three"
        }
        scale id="gauge" mode="radial" min=0 max=10 value=7 major_ticks=3 minor_ticks=2 start_angle=180 end_angle=0 show_labels=true show_needle=true tick_color="#00ffff" needle_color="#ff00ff" style="{ let mut style = Style::panel(); style.background = Some(Rgb565::new(4, 0, 8)); style.gradient = None; style.text = Rgb565::new(31, 63, 0); style }" col=20 row=11 col_span=4 row_span=14
        slider id="sld" min=0 max=10 value=5 style="{ let mut style = Style::label(); style.text = Rgb565::new(31, 0, 31); style.accent = Rgb565::new(0, 63, 0); style }" col=5 row=11 col_span=4 row_span=1
        arc id="arc" progress=0.7 clockwise=false arc_radius=0 frame_inset=3 corner_radius=2 bg_color="#220044" arc_color="#ff8800" frame_color="#00ffff" style="{ let mut style = Style::label(); style.corner_radius = 2; style }" col=5 row=13 col_span=4 row_span=4
        busy_wheel id="whl" phase=0.25 style="{ let mut style = Style::label(); style.background = Some(Rgb565::new(0, 12, 0)); style.gradient = None; style.accent = Rgb565::new(31, 63, 0); style }" col=5 row=18 col_span=2 row_span=5
        content_indicator id="ind" count=4 active=2 style="{ let mut style = Style::label(); style.background = Some(Rgb565::new(2, 4, 2)); style.gradient = None; style.accent = Rgb565::new(31, 0, 0); style }" col=5 row=24 col_span=3 row_span=5
        crumbs id="crm" count=3 active=1 style="{ let mut style = Style::label(); style.background = Some(Rgb565::new(2, 4, 2)); style.gradient = None; style.accent = Rgb565::new(0, 63, 31); style }" col=5 row=30 col_span=3 row_span=2
        chart id="cht" values="1,4,2,5" min=1 max=5 style="{ let mut style = Style::label(); style.background = Some(Rgb565::new(0, 0, 6)); style.gradient = None; style.accent = Rgb565::new(31, 0, 0); style }" col=9 row=35 col_span=3 row_span=7
        plotter id="plt" values="1,2,3,4" head=2 min=0 max=4 style="{ let mut style = Style::label(); style.background = Some(Rgb565::new(0, 12, 6)); style.gradient = None; style.accent = Rgb565::new(31, 63, 0); style }" col=13 row=35 col_span=2 row_span=7
        path id="pth" d="M 2 2 L 36 2 Q 38 20 20 36 Z" stroke_width=2 colour="#ff00ff" col=22 row=27 col_span=2 row_span=11
        status_bar id="stb" time="07:45" style="{ let mut style = Style::label(); style.background = Some(Rgb565::new(6, 0, 0)); style.gradient = None; style.text = Rgb565::new(31, 63, 31); style }" col=20 row=41 col_span=4 row_span=3
        time_picker id="tme" hour=7 minute=45 is_12h=false is_pm=true style="{ let mut style = Style::label(); style.background = Some(Rgb565::new(4, 0, 4)); style.gradient = None; style.accent = Rgb565::new(31, 0, 31); style }" col=20 row=27 col_span=1 row_span=9
        number_picker id="num" min=0 max=20 value=11 unit="kPa" col=20 row=37 col_span=1 row_span=3
        triangle id="trib" stroke_width=2 fill="#ff0000" stroke="#00ff00" p1x=500 p1y=0 p2x=0 p2y=1000 p3x=1000 p3y=1000 col=16 row=39 col_span=1 row_span=7
        line id="rule" stroke_width=2 color="#0000ff" col=16 row=47 col_span=3 row_span=1
    }
}
