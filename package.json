        "viewsContainers": {
            "activitybar": [
                {
                    "id": "rustyPlatform",
                    "title": "Rusty Platform",
                    "icon": "resources/icon.svg"
                }
            ]
        },
        "views": {
            "rustyPlatform": [
                {
                    "id": "rustyPlatform.controls",
                    "name": "Controls"
                },
                {
                    "id": "rustyPlatform.boards",
                    "name": "Boards"
                },
                {
                    "id": "rustyPlatform.project",
                    "name": "Project"
                },
                {
                    "id": "rustyPlatform.assistant",
                    "name": "AI Assist",
                    "type": "webview"
                }
            ]
        },
        "keybindings": [
            {
                "command": "rustyPlatform.assistant.sendPrompt",
                "key": "ctrl+alt+enter",
                "mac": "cmd+alt+enter",
                "when": "editorTextFocus && editorLangId == rust"
            },
            {
                "command": "rustyPlatform.assistant.cancelPrompt",
                "key": "ctrl+alt+escape",
                "mac": "cmd+alt+escape",
                "when": "editorTextFocus && editorLangId == rust"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "rustyPlatform.assistant.openEditor",
                    "when": "view == rustyPlatform.assistant",
                    "group": "navigation"
                },
                {
                    "command": "rustyPlatform.newProject",
                    "when": "view == rustyPlatform.boards",
                    "group": "navigation@1"
                },
                {
                    "command": "rustyPlatform.newProject",
                    "when": "view == rustyPlatform.project",
                    "group": "navigation@1"
                },
                {
                    "command": "rustyPlatform.addDependency",
                    "when": "view == rustyPlatform.project",
                    "group": "navigation@1"
                },
                {
                    "command": "rustyPlatform.refresh",
                    "when": "view == rustyPlatform.boards || view == rustyPlatform.project || view == rustyPlatform.controls",
                    "group": "navigation@2"
                },
                {
                    "command": "rustyPlatform.assistant.implement",
                    "when": "view == rustyPlatform.assistant",
                    "group": "navigation@1"
                },
                {
                    "command": "rustyPlatform.assistant.status",
                    "when": "view == rustyPlatform.assistant",
                    "group": "navigation@2"
                },
                {
                    "command": "rustyPlatform.openDesigner",
                    "when": "view == rustyPlatform.project && rustyPlatform.designerProject",
                    "group": "navigation@1"
                }
            ],
            "view/item/context": [
                {
                    "command": "rustyPlatform.addDependency",
                    "when": "view == rustyPlatform.project && viewItem == rustyPlatform.dependencies",
                    "group": "inline@1"
                }
            ],
            "commandPalette": [
                {
                    "command": "rustyPlatform.refresh",
                    "when": "false"
                },
                {
                    "command": "rustyPlatform.revealDependency",
                    "when": "false"
                },
                {
                    "command": "rustyPlatform.assistant.sendPrompt",
                    "when": "false"
                },
                {
                    "command": "rustyPlatform.assistant.cancelPrompt",
                    "when": "false"
                },
                {
                    "command": "rustyPlatform.assistant.applyProposal",
                    "when": "false"
                },
                {
                    "command": "rustyPlatform.assistant.discardProposal",
                    "when": "false"
                },
                {
                    "command": "rustyPlatform.assistant.fixFinding",
                    "when": "false"
                }
            ]
        },
        "configuration": {
            "title": "Rusty Platform",
            "properties": {
                "rustyPlatform.cargoPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Explicit path to `cargo`. Leave empty to auto-detect (`~/.cargo/bin`, then `PATH`)."
                },
                "rustyPlatform.probeRsPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Explicit path to `probe-rs`. Leave empty to auto-detect."
                },
                "rustyPlatform.espflashPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Explicit path to `espflash`. Leave empty to auto-detect (`~/.cargo/bin`, then `PATH`)."
                },
                "rustyPlatform.lcdRotation": {
                    "type": "number",
                    "enum": [
                        0,
                        1,
                        2,
                        3
                    ],
                    "enumDescriptions": [
                        "No rotation. What the panel does when it is not told otherwise.",
                        "90 degrees clockwise.",
                        "180 degrees clockwise.",
                        "270 degrees clockwise."
                    ],
                    "default": 0,
                    "scope": "resource",
                    "markdownDescription": "How far to turn the LCD in this project. Written into the project's `.cargo/esp-config.toml` as `LCD_ROTATION` and read by the generated firmware at **compile time**, so changing it never means editing `src/main.rs`. The rotation turns the whole image; the drawing area keeps the panel's native size."
                },
                "rustyPlatform.flashProfile": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "debug",
                        "release"
                    ],
                    "enumDescriptions": [
                        "Let the board decide: release for an ESP chip (there is no debug session on the USB-serial route, and a debug build paints a panel about 130x slower), debug for a Raspberry Pi board (the build a probe-rs session can step through).",
                        "Always build the debug profile. Debuggable, but on a panel it is the slow one: the generated display screen takes tens of seconds to paint.",
                        "Always build the release profile. Fast and small, but breakpoints in a probe-rs session will be hollow."
                    ],
                    "default": "auto",
                    "markdownDescription": "Which build **Flash** writes to the chip. *Flash with Debug Profile* and *Flash with Release Profile* override it for one flash. `auto` is `release` for ESP boards and `debug` for Raspberry Pi ones."
                },
                "rustyPlatform.serialPort": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Serial port used when flashing an ESP32, e.g. `/dev/ttyUSB0`. Leave empty to detect it — with more than one board attached, espflash asks."
                },
                "rustyPlatform.defaultBoard": {
                    "type": "string",
                    "default": "pico",
                    "enum": [
                        "pico",
                        "pico2",
                        "picow",
                        "pico2w",
                        "esp32-devkitc",
                        "lilygo-tqt",
                        "sunton-3248s035r"
                    ],
                    "markdownDescription": "Board pre-selected in the New Project wizard."
                },
                "rustyPlatform.defmtLogLevel": {
                    "type": "string",
                    "default": "debug",
                    "enum": [
                        "off",
                        "error",
                        "warn",
                        "info",
                        "debug",
                        "trace"
                    ],
                    "markdownDescription": "Value written to `DEFMT_LOG` when running build/flash/monitor."
                },
                "rustyPlatform.revealTerminalOnRun": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show the terminal when a build/flash/monitor command starts."
                },
                "rustyPlatform.promptMissingRequirements": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Ask, when the window loads or when the open project changes what is needed, about anything the toolchain is missing (cargo, probe-rs, targets, the ESP toolchain, the probe's firmware) — with a button that installs it. The same rules as the health row decide *what* is missing, so a project is never asked about a tool its route cannot use. “Don't Show Again” on the prompt remembers that particular set of requirements; switch this off to be asked nothing at all."
                },
                "rustyPlatform.assistant.enabled": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "The AI assistant's switch. **Off** (the default) unloads every local model it can find and stops the `llama-server` serving the configured endpoint — including a server this window did not start, after asking once per window. **On** starts the configured backend and loads its model. The switch is also in the AI Assist panel, and `Rusty AI: Toggle On/Off` toggles it from the palette."
                },
                "rustyPlatform.assistant.stopServersAtStartup": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "When a window starts with the assistant switched off, unload the models and stop the `llama-server`. On by default, because that is what \"off\" means; turn it off if you run your own `llama-server` for other work and do not want an editor stopping it at launch. A server this window did not start is still only stopped after asking once."
                },
                "rustyPlatform.assistant.backend": {
                    "type": "string",
                    "enum": [
                        "off",
                        "external",
                        "bundled"
                    ],
                    "default": "off",
                    "markdownDescription": "How the AI coding assist gets its model. `off` disables it entirely. `external` talks to any OpenAI-compatible server you already run (LM Studio, Ollama, your own `llama-server`). `bundled` builds and runs the extension's own local runtime — no other AI needed."
                },
                "rustyPlatform.assistant.endpoint": {
                    "type": "string",
                    "default": "http://127.0.0.1:1234/v1",
                    "markdownDescription": "Base URL of the OpenAI-compatible API used with `external`, e.g. `http://127.0.0.1:1234/v1`."
                },
                "rustyPlatform.assistant.model": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Model id to ask for. Leave empty to let the server pick (some servers, like Ollama, refuse an unnamed request — then set this)."
                },
                "rustyPlatform.assistant.modelPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "The `.gguf` file the bundled runtime serves. Set by **Rusty AI: Choose a Local Model…**."
                },
                "rustyPlatform.assistant.threads": {
                    "type": "number",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 32,
                    "markdownDescription": "CPU threads for the bundled runtime. `0` chooses automatically (one less than the core count, capped at 8)."
                },
                "rustyPlatform.assistant.contextSize": {
                    "type": "number",
                    "default": 4096,
                    "minimum": 512,
                    "maximum": 262144,
                    "markdownDescription": "Context window handed to the bundled runtime. `0` grows it to hold the answer budget (`maxTokens`) plus 2048 tokens."
                },
                "rustyPlatform.assistant.gpuLayers": {
                    "type": "number",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 999,
                    "markdownDescription": "Layers offloaded to the GPU by the bundled runtime. `0` is CPU only."
                },
                "rustyPlatform.assistant.bundledBackend": {
                    "type": "string",
                    "enum": [
                        "cpu",
                        "vulkan",
                        "cuda",
                        "metal"
                    ],
                    "default": "cpu",
                    "markdownDescription": "Which native backend the bundled runtime is built and run with. `cpu` needs nothing beyond Rust; the GPU backends need that platform's SDK at build time. The runtime reports back what it actually loaded, so this is a request, not a guarantee."
                },
                "rustyPlatform.assistant.loadContextLength": {
                    "type": "number",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 262144,
                    "markdownDescription": "Context window the **Load Model** button asks for, in tokens. `0` means \"use the recommended size for this machine\". It is remembered per machine so the panel reopens with the numbers you last chose."
                },
                "rustyPlatform.assistant.loadGpu": {
                    "type": "string",
                    "default": "auto",
                    "markdownDescription": "GPU offload the **Load Model** button asks for: `auto` decides from the model's size and this machine's memory, `off` is CPU only, `max` offloads everything, `0.5` asks for half. A plain string rather than an enum on purpose — the panel writes ratios here, and a value the schema rejects would be silently dropped."
                },
                "rustyPlatform.assistant.loadTtlSeconds": {
                    "type": "number",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 86400,
                    "markdownDescription": "How long a model loaded through LM Studio stays in memory when idle. `0` means \"no timer\" — it stays until something unloads it."
                },
                "rustyPlatform.assistant.gpuVramGb": {
                    "type": "number",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 256,
                    "markdownDescription": "Dedicated graphics memory, in GB, when this extension cannot detect it. `0` means \"ask the driver\" (NVIDIA via `nvidia-smi`, AMD via sysfs). It is used to decide whether a model's layers fit on the card: an integrated GPU shares system memory and is deliberately reported as *no card*, so leave this at `0` unless you know yours has dedicated VRAM."
                },
                "rustyPlatform.assistant.llamaServerPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "The `llama-server` binary to run for **My own llama-server**. Empty means \"find it yourself\" (PATH and the usual build folders); if nothing is found, **Rusty AI: Start My llama-server…** offers to download llama.cpp's own prebuilt build for this platform. Set it yourself to use a build you compiled."
                },
                "rustyPlatform.assistant.llamaServerArgs": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Extra flags added to your `llama-server` command line, last so they win. Example: `--flash-attn on --no-warmup`. Relative paths resolve against the model file's own folder."
                },
                "rustyPlatform.assistant.llamaServerModelPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "The `.gguf` **My own llama-server** runs. Set by **Rusty AI: Start My llama-server…** — the file you pick, or the known 27B fetched for you. Kept separately from `modelPath`, which is the built-in runtime's own model, so the two engines cannot change each other's weights."
                },
                "rustyPlatform.assistant.llamaServerService": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "The systemd **user** unit that runs your `llama-server` (e.g. `llama-server.service`). Empty means \"work it out from the running server\", and on a machine with more than one such unit the extension asks rather than guessing which one to stop."
                },
                "rustyPlatform.assistant.llamaServerStartTarget": {
                    "type": "string",
                    "enum": [
                        "unit",
                        "process"
                    ],
                    "default": "unit",
                    "markdownDescription": "How **Start server** starts your llama.cpp: `unit` starts the systemd user service (so it keeps running after VS Code closes), `process` starts it as a child of this window (so `Stop` can end it). The other route is tried — and reported — when the chosen one fails."
                },
                "rustyPlatform.assistant.timeoutSeconds": {
                    "type": "number",
                    "default": 60,
                    "minimum": 5,
                    "maximum": 600,
                    "markdownDescription": "How long the model may go **without producing anything** before the request is treated as dead. It is an inactivity budget, not a total one: a slow CPU model that keeps writing is never cut off."
                },
                "rustyPlatform.assistant.maxTokens": {
                    "type": "number",
                    "default": 4096,
                    "minimum": 64,
                    "maximum": 8192,
                    "markdownDescription": "The longest answer the model may write. Thinking models spend this budget before writing any code, which is the usual reason a raise is needed."
                },
                "rustyPlatform.assistant.temperature": {
                    "type": "number",
                    "default": 0.2,
                    "minimum": 0,
                    "maximum": 1,
                    "markdownDescription": "Sampling temperature. Low is right for code: the same request should produce the same function."
                },
                "rustyPlatform.assistant.showDiff": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show the model's code as a diff before it is written. Switched off, the edit is applied directly — still a normal edit, so Ctrl+Z undoes it."
                },
                "rustyPlatform.assistant.verifyAfterApply": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "After a proposal is applied, offer to check the project with `cargo check`."
                },
                "rustyPlatform.assistant.conventions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "markdownDescription": "House rules measured from your own code and accepted with **Rusty AI: Learn the House Rules from My Code…**. They are put in every prompt."
                },
                "rustyPlatform.assistant.ignoreHostCheck": {
                    "type": "boolean",
