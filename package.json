                "category": "Rusty AI",
                "icon": "$(sparkle)"
            },
            {
                "command": "rustyPlatform.assistant.sendPrompt",
                "title": "Send the Prompt in the ✎ AI Block",
                "category": "Rusty AI"
            },
            {
                "command": "rustyPlatform.assistant.cancelPrompt",
