            },
            {
                "command": "rustyPlatform.assistant.openPanel",
                "title": "Open the Assistant Panel",
                "category": "Rusty AI",
                "icon": "$(comment-discussion)"
            },
            {
                "command": "rustyPlatform.assistant.openSettings",
                "title": "Open the AI Assist Settings",
