{
    "name": "grumpy-rusty-platform",
    "displayName": "Grumpy's Rusty Platform for VS Code",
    "description": "PlatformIO-style embedded development for RP2040/RP2350 (Raspberry Pi Pico) and ESP32/ESP32-S3 boards in Rust (Embassy, esp-hal, probe-rs, espflash).",
    "icon": "resources/grumpy.png",
    "version": "0.13.24",
    "publisher": "grumpy",
    "license": "MIT OR Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/OomNiel/grumpy-rusty-platform.git"
    },
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Programming Languages",
        "Debuggers",
        "Other"
    ],
    "keywords": [
        "rust",
        "embedded",
        "embassy",
        "rp2040",
        "rp2350",
        "pico",
        "probe-rs",
        "defmt"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./ && tsc -p tsconfig.webview.json && node scripts/build-webview.mjs",
        "watch": "tsc -watch -p ./",
        "lint": "tsc -p ./ --noEmit && tsc -p tsconfig.webview.json",
        "test": "node tests/runner.js",
        "dap-session": "node tests/tools/dap-session.js"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "@types/vscode": "^1.90.0",
        "esbuild": "^0.28.2",
        "typescript": "^5.6.3"
    },
    "contributes": {
        "commands": [
            {
                "command": "rustyPlatform.newProject",
                "title": "New Project…",
                "category": "Rusty Platform",
                "icon": "$(new-folder)"
            },
            {
                "command": "rustyPlatform.build",
                "title": "Build",
                "category": "Rusty Platform",
                "icon": "$(tools)"
            },
            {
                "command": "rustyPlatform.buildDebug",
                "title": "Build for Debug",
                "category": "Rusty Platform",
                "icon": "$(tools)"
            },
            {
                "command": "rustyPlatform.buildRelease",
                "title": "Build for Release",
                "category": "Rusty Platform",
                "icon": "$(rocket)"
            },
            {
                "command": "rustyPlatform.flash",
                "title": "Flash",
                "category": "Rusty Platform",
                "icon": "$(zap)"
            },
            {
                "command": "rustyPlatform.flashDebug",
                "title": "Flash with Debug Profile",
                "category": "Rusty Platform",
                "icon": "$(bug)"
            },
            {
                "command": "rustyPlatform.flashRelease",
                "title": "Flash with Release Profile",
                "category": "Rusty Platform",
                "icon": "$(rocket)"
            },
            {
                "command": "rustyPlatform.flashUsb",
                "title": "Flash over USB (BOOTSEL)…",
                "category": "Rusty Platform",
                "icon": "$(plug)"
            },
            {
                "command": "rustyPlatform.debug",
                "title": "Debug",
                "category": "Rusty Platform",
                "icon": "$(debug-alt)"
            },
            {
                "command": "rustyPlatform.debugStop",
                "title": "Stop Debugging",
                "category": "Rusty Platform",
                "icon": "$(debug-stop)"
            },
            {
                "command": "rustyPlatform.checkLaunchConfig",
                "title": "Check Debug Configuration",
                "category": "Rusty Platform",
                "icon": "$(checklist)"
            },
            {
                "command": "rustyPlatform.setWifiCredentials",
                "title": "Set Wi-Fi Credentials…",
                "category": "Rusty Platform"
            },
            {
                "command": "rustyPlatform.clearWifiCredentials",
                "title": "Clear Wi-Fi Credentials",
                "category": "Rusty Platform"
            },
            {
                "command": "rustyPlatform.monitor",
                "title": "Monitor (defmt)",
                "category": "Rusty Platform",
                "icon": "$(output)"
            },
            {
                "command": "rustyPlatform.clean",
                "title": "Clean",
