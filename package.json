            },
            {
                "command": "rustyPlatform.assistant.discardProposal",
                "title": "Discard the Proposed Change",
                "category": "Rusty AI"
            },
            {
                "command": "rustyPlatform.assistant.fixFinding",
                "title": "Fix a Finding with AI",
                "category": "Rusty AI"
            },
            {
                "command": "rustyPlatform.assistant.repair",
                "title": "Fix the Build…",
                "category": "Rusty AI",
                "icon": "$(wand)"
            },
            {
                "command": "rustyPlatform.assistant.check",
                "title": "Check the Project (cargo check)",
                "category": "Rusty AI"
            },
            {
                "command": "rustyPlatform.assistant.learnConventions",
                "title": "Learn the House Rules from My Code…",
                "category": "Rusty AI"
            },
            {
                "command": "rustyPlatform.assistant.status",
                "title": "Status and Hardware Check",
                "category": "Rusty AI"
            },
            {
                "command": "rustyPlatform.assistant.setupModel",
                "title": "Choose a Local Model…",
                "category": "Rusty AI",
                "icon": "$(server-process)"
            },
            {
                "command": "rustyPlatform.assistant.toggle",
                "title": "Toggle On/Off",
                "category": "Rusty AI",
                "icon": "$(sparkle)"
            },
            {
                "command": "rustyPlatform.assistant.unloadModel",
                "title": "Unload the Loaded Model",
