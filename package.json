            {
                "command": "rustyPlatform.publishDeb",
                "title": "Publish .deb",
                "category": "Rusty Platform",
                "icon": "$(package)"
            },
            {
                "command": "rustyPlatform.installDeb",
                "title": "Install .deb",
                "category": "Rusty Platform",
                "icon": "$(desktop-download)"
            },
            {
                "command": "rustyPlatform.backupProject",
                "title": "Back Up Project",
